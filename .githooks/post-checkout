#!/bin/sh

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 0

python_cmd=""
python_candidate="$repo_root/.venv/bin/python"
if [ -x "$python_candidate" ] &&
    "$python_candidate" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 11))' >/dev/null 2>&1; then
    python_cmd="$python_candidate"
fi
if [ -z "$python_cmd" ] && command -v uv >/dev/null 2>&1; then
    python_candidate=$(
        uv python find --managed-python --no-project 3.11.13 2>/dev/null || true
    )
    if [ -n "$python_candidate" ] &&
        "$python_candidate" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 11))' >/dev/null 2>&1; then
        python_cmd="$python_candidate"
    fi
fi
if [ -z "$python_cmd" ] && command -v python3 >/dev/null 2>&1; then
    if python3 -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 11))' >/dev/null 2>&1; then
        python_cmd="python3"
    fi
fi
if [ -z "$python_cmd" ]; then
    echo "warning: Python 3.11.13 unavailable; local bootstrap skipped" >&2
    exit 0
fi

"$python_cmd" scripts/setup/bootstrap_local_state.py --quiet || {
    echo "warning: could not initialize local SLM lab workspace" >&2
    exit 0
}
