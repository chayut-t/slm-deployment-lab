{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slm-lab/benchmark-result-v1.schema.json",
  "title": "SLM Lab benchmark metric result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_sha256",
    "result_id",
    "task_id",
    "created_at",
    "source",
    "system",
    "measurement",
    "samples",
    "summary",
    "validity",
    "comparison"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "const": "slm-lab-benchmark-v1"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "tokenizer_revision",
        "artifact_id",
        "artifact_sha256",
        "git_commit",
        "workload_id",
        "precision",
        "generation_policy_id"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 7
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 7
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "workload_id": {
          "enum": [
            "S128",
            "S512",
            "S1024",
            "S4096",
            "decode_probe",
            "academic_evaluation",
            "numerical_canary"
          ]
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "generation_policy_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_level",
        "platform",
        "device_name",
        "device_type",
        "os",
        "runtime",
        "runtime_version",
        "provider_or_compute_unit",
        "placement_evidence",
        "host_manifest_sha256"
      ],
      "properties": {
        "evidence_level": {
          "enum": [
            "observed_real_device",
            "observed_hosted_device",
            "simulated",
            "estimated"
          ]
        },
        "platform": {
          "enum": [
            "qualcomm",
            "apple",
            "nvidia",
            "cpu_reference",
            "other"
          ]
        },
        "device_name": {
          "type": "string",
          "minLength": 1
        },
        "device_type": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": [
            "string",
            "null"
          ]
        },
        "compiler_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provider_or_compute_unit": {
          "type": "string",
          "minLength": 1
        },
        "placement_evidence": {
          "type": "string",
          "minLength": 1
        },
        "host_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timing_class",
        "scope",
        "metric",
        "unit",
        "timing_boundary",
        "synchronization",
        "process_isolation",
        "warmup_repetitions",
        "measured_repetitions",
        "includes",
        "excludes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "performance",
            "memory",
            "power_thermal",
            "quality",
            "numerical"
          ]
        },
        "timing_class": {
          "oneOf": [
            {
              "enum": [
                "single_graph",
                "runtime_stage",
                "generation_loop",
                "end_to_end_request",
                "cold_start"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "graph",
            "runtime_stage",
            "generation_loop",
            "end_to_end_request",
            "cold_start",
            "evaluation",
            "numerical_validation",
            "resource_observation"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "seconds",
            "tokens_per_second",
            "bytes",
            "watts",
            "joules_per_token",
            "ratio",
            "nats",
            "bits_per_byte",
            "perplexity"
          ]
        },
        "timing_boundary": {
          "type": "string",
          "minLength": 1
        },
        "synchronization": {
          "$ref": "#/$defs/synchronizationEvidence"
        },
        "process_isolation": {
          "$ref": "#/$defs/processIsolation"
        },
        "warmup_repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "measured_repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "actual_prompt_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "actual_generated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "memory_method": {
          "$ref": "#/$defs/memoryMethod"
        },
        "power_thermal_method": {
          "$ref": "#/$defs/powerThermalMethod"
        },
        "quality_method": {
          "$ref": "#/$defs/qualityMethod"
        },
        "numerical_method": {
          "$ref": "#/$defs/numericalMethod"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_index",
          "value",
          "valid",
          "invalid_reason"
        ],
        "properties": {
          "sample_index": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "valid": {
            "type": "boolean"
          },
          "invalid_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "timer_failure",
              "runtime_error",
              "integrity_failure",
              "wrong_device_or_provider",
              "environmental_threshold_breach",
              "external_interruption"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count_total",
        "sample_count_valid",
        "sample_count_invalid",
        "minimum",
        "maximum",
        "mean",
        "sample_standard_deviation",
        "median",
        "p90",
        "p95",
        "median_absolute_deviation",
        "interquartile_range"
      ],
      "properties": {
        "sample_count_total": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count_valid": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "sample_standard_deviation": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "median_absolute_deviation": {
          "type": "number",
          "minimum": 0
        },
        "interquartile_range": {
          "type": "number",
          "minimum": 0
        },
        "median_confidence_interval_95": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reasons",
        "headline_eligible"
      ],
      "properties": {
        "state": {
          "enum": [
            "valid",
            "incomplete"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headline_eligible": {
          "type": "boolean"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_scope",
        "comparable_dimensions",
        "non_comparable_dimensions",
        "system_difference_notes"
      ],
      "properties": {
        "claim_scope": {
          "const": "system_result"
        },
        "comparable_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_comparable_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "system_difference_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "synchronizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "method_id",
        "pre_timer_action",
        "post_timer_action",
        "evidence"
      ],
      "properties": {
        "backend": {
          "enum": [
            "pytorch_cpu",
            "onnxruntime_cpu",
            "onnxruntime_cuda",
            "mlx",
            "qualcomm_workbench",
            "qualcomm_device_cloud",
            "generic_accelerator"
          ]
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "pre_timer_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_timer_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_process_each_repetition",
        "reset_method",
        "process_identity_evidence"
      ],
      "properties": {
        "fresh_process_each_repetition": {
          "type": "boolean"
        },
        "reset_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "process_identity_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "memoryMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "method",
        "sampling_interval",
        "measurement_interval",
        "baseline_policy"
      ],
      "properties": {
        "domain": {
          "enum": [
            "process_rss",
            "system_memory",
            "unified_memory",
            "accelerator_allocation",
            "runtime_reported",
            "service_estimate"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "sampling_interval": {
          "type": "string",
          "minLength": 1
        },
        "measurement_interval": {
          "type": "string",
          "minLength": 1
        },
        "baseline_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "powerThermalMethod": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "baseline_subtracted": {
                "const": true
              }
            },
            "required": [
              "baseline_subtracted"
            ]
          },
          "then": {
            "properties": {
              "idle_baseline_watts": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ],
      "required": [
        "instrument",
        "sample_rate_hz",
        "duration_seconds",
        "measurement_domain",
        "idle_baseline_watts",
        "baseline_subtracted",
        "start_temperature",
        "end_temperature",
        "thermal_state",
        "ambient_notes"
      ],
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "sample_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 600
        },
        "measurement_domain": {
          "type": "string",
          "minLength": 1
        },
        "idle_baseline_watts": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "baseline_subtracted": {
          "type": "boolean"
        },
        "start_temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "end_temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "thermal_state": {
          "type": "string",
          "minLength": 1
        },
        "ambient_notes": {
          "type": "string"
        }
      }
    },
    "qualityMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "task_id",
        "metric_name",
        "dataset_id",
        "dataset_revision",
        "dataset_config",
        "harness_release",
        "harness_commit",
        "resolved_task_sha256",
        "split",
        "selection",
        "prompt_interface",
        "apply_chat_template",
        "fewshot"
      ],
      "properties": {
        "suite_id": {
          "const": "slm-lab-academic-regression-v1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_revision": {
          "type": "string",
          "minLength": 7
        },
        "dataset_config": {
          "type": "string",
          "minLength": 1
        },
        "harness_release": {
          "const": "v0.4.12"
        },
        "harness_commit": {
          "$ref": "#/$defs/gitSha"
        },
        "resolved_task_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "limit",
            "shuffle",
            "seed"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "shuffle": {
              "type": "boolean"
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "prompt_interface": {
          "type": "string",
          "minLength": 1
        },
        "apply_chat_template": {
          "type": "boolean"
        },
        "fewshot": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "numericalMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_level",
        "tensor",
        "reduction",
        "reference_dtype",
        "candidate_dtype",
        "tolerance_policy_id"
      ],
      "properties": {
        "reference_level": {
          "enum": [
            "golden_reference",
            "deployment_floating_baseline",
            "quantized_candidate"
          ]
        },
        "tensor": {
          "type": "string",
          "minLength": 1
        },
        "reduction": {
          "type": "string",
          "minLength": 1
        },
        "reference_dtype": {
          "type": "string",
          "minLength": 1
        },
        "candidate_dtype": {
          "type": "string",
          "minLength": 1
        },
        "decode_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tolerance_policy_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
